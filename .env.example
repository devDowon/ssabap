# 복사해서 .env로 저장 후 값 채우기. .env는 git에 올라가지 않음.
# 따옴표 없이 값만 쓰기.

# 웰스토리(웰플러스) 로그인 계정 (필수)
WELSTORY_USERNAME=
WELSTORY_PASSWORD=

# Mattermost incoming webhook URL (실제 전송 시 필수, --dry-run이면 비워도 됨)
MM_WEBHOOK_URL=

# 식당 지정 (선택, 둘 다 비우면 내 식당 목록 첫 번째 사용)
RESTAURANT_CODE=
RESTAURANT_NAME=

# 보낼 코스의 홀 코드 (선택, 기본 E32M = 점심 코스 6개. 테이크아웃/코인 메뉴 제외용). 쉼표로 여러 개
HALL_NO=
